# ============================================================
# FlowAI Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.
# ============================================================

# --- FlowAI Metadata Database ---
FLOWAI_DB_HOST=localhost
FLOWAI_DB_PORT=5432
FLOWAI_DB_NAME=flowai_db
FLOWAI_DB_USER=flowai_user
FLOWAI_DB_PASSWORD=change_me_in_production

# --- JWT ---
JWT_SECRET=change_this_to_a_very_long_random_string_at_least_256_bits
JWT_EXPIRATION_MS=86400000

# --- Ollama (Phase 16) ---
OLLAMA_BASE_URL=http://localhost:11434